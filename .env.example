# Production Environment Configuration Template
# Copy this file to .env and update with your actual values

# Docker Hub Image (replace 'vutheviet' with your Docker Hub username)
DOCKER_IMAGE=vutheviet/ladifinal:latest

# Application Security
SECRET_KEY=your-super-secret-key-change-this-in-production

# Server Configuration
PORT=5001
DOMAIN=phuhieutoanquoc.shop

# Flask Environment
FLASK_ENV=production

# File Paths (usually don't need to change these)
PUBLISHED_ROOT=/app/published
UPLOAD_FOLDER=/app/uploads

# Google Ads click/IP suggestion tool
CLICK_TRACKING_ENABLED=true
TRUST_CLOUDFLARE_IP=true
CLICK_TRACKING_RETENTION_DAYS=90
# Comma-separated ISO country codes. Leave empty to disable country scoring.
CLICK_TRACKING_ALLOWED_COUNTRIES=VN
